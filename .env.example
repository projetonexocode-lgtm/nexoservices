# Payload CMS
PAYLOAD_SECRET=replace-with-a-long-random-string
# Local SQLite (default). On Vercel use Neon Postgres, e.g. postgres://...
DATABASE_URL=file:./payload.db
# Optional direct (non-pooled) Neon URL for migrations
# DATABASE_URL_UNPOOLED=
# NEON_BRANCH=production
# Optional: auto-create first admin on boot
PAYLOAD_ADMIN_EMAIL=admin@nexoservices.pt
PAYLOAD_ADMIN_PASSWORD=ChangeMe123!

# Contact form (Resend) — required in production for /api/contact
# RESEND_API_KEY=
# CONTACT_EMAIL=contacto@nexoservices.pt
# CONTACT_FROM_EMAIL=Nexo Services <onboarding@resend.dev>
